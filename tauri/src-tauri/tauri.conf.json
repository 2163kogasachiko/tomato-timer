{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomatoTimer-Tauri-Proto",
  "version": "0.1.0",
  "identifier": "com.codex.tomatotimer.tauriproto",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "トマトタイマー (Tauri試作)",
        "width": 420,
        "height": 430,
        "minWidth": 300,
        "minHeight": 310,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
